{
  "name": "expressjs-typescript-example-tutorial",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node ./dist/index.js",
    "dev": "node --watch ./src/index.ts",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "npm test -- --watchAll",
    "typecheck": "tsc --noemit",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --testPathPatterns=src/e2e",
    "test:all": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --testPathPatterns='__tests__|src/e2e'",
    "verify": "npm run typecheck && npm run test:all && npm run build"
  },
  "keywords": [],
  "dependencies": {
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "passport": "^0.7.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "@jest/globals": "^30.5.2",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^30.0.0",
    "@types/passport": "^1.0.17",
    "@types/supertest": "^7.2.1",
    "babel-jest": "^30.5.2",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "typescript": "7.0.2"
  }
}
